# PostgreSQL (source)
PG_HOST=localhost
PG_PORT=5433
PG_DATABASE=commerce
PG_USER=commerce_user
PG_PASSWORD=commerce_pass

# Snowflake (warehouse) — leave blank if using DuckDB
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_DATABASE=COMMERCE_ANALYTICS
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=TRANSFORM

# DuckDB (local warehouse alternative)
DUCKDB_PATH=./warehouse.duckdb
