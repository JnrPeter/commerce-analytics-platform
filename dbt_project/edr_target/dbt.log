ommerce_ingestion", "identifier": "alerts_schema_changes", "schema": "main"}, {"database": "commerce_ingestion", "identifier": "anomaly_threshold_sensitivity", "schema": "main"}, {"database": "commerce_ingestion", "identifier": "dbt_artifacts_hashes", "schema": "main"}, {"database": "commerce_ingestion", "identifier": "job_run_results", "schema": "main"}, {"database": "commerce_ingestion", "identifier": "metrics_anomaly_score", "schema": "main"}, {"database": "commerce_ingestion", "identifier": "model_run_results", "schema": "main"}, {"database": "commerce_ingestion", "identifier": "monitors_runs", "schema": "main"}, {"database": "commerce_ingestion", "identifier": "seed_run_results", "schema": "main"}, {"database": "commerce_ingestion", "identifier": "snapshot_run_results", "schema": "main"}], "schema": "main"}, "info": {"category": "", "code": "E014", "extra": {}, "invocation_id": "872a4f46-5676-45fb-b150-c9092d988dd6", "level": "debug", "msg": "While listing relations in database=commerce_ingestion, schema=main, found: data_monitoring_metrics, dbt_columns, dbt_exposures, dbt_groups, dbt_invocations, dbt_metrics, dbt_models, dbt_run_results, dbt_seeds, dbt_snapshots, dbt_sources, dbt_source_freshness_results, dbt_tests, elementary_test_results, metadata, schema_columns_snapshot, test_result_rows, zone_lookup, alerts_anomaly_detection, alerts_dbt_models, alerts_dbt_source_freshness, alerts_dbt_tests, alerts_schema_changes, anomaly_threshold_sensitivity, dbt_artifacts_hashes, job_run_results, metrics_anomaly_score, model_run_results, monitors_runs, seed_run_results, snapshot_run_results", "name": "ListRelations", "pid": 9022, "thread": "MainThread", "ts": "2026-10-06T09:35:20.672978Z"}}
