{"data": {"conn_name": "macro_log_macro_results", "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.12.5\", \"profile_name\": \"elementary\", \"target_name\": \"dev\", \"connection_name\": \"macro_log_macro_results\"} */\n\n      select\n          column_name,\n          column_type as data_type,\n          cast(null as bigint) as character_maximum_length,\n          cast(null as bigint) as numeric_precision,\n          cast(null as bigint) as numeric_scale\n      from (describe \"commerce_ingestion\".\"main\".\"dbt_source_freshness_results\")\n  "}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "e42e1dd7-b117-41b1-955e-f92ba3b9da0f", "level": "debug", "msg": "On macro_log_macro_results: /* {\"app\": \"dbt\", \"dbt_version\": \"1.12.5\", \"profile_name\": \"elementary\", \"target_name\": \"dev\", \"connection_name\": \"macro_log_macro_results\"} */\n\n      select\n          column_name,\n          column_type as data_type,\n          cast(null as bigint) as character_maximum_length,\n          cast(null as bigint) as numeric_precision,\n          cast(null as bigint) as numeric_scale\n      from (describe \"commerce_ingestion\".\"main\".\"dbt_source_freshness_results\")\n  ", "name": "SQLQuery", "pid": 14633, "thread": "MainThread", "ts": "2026-10-09T10:04:32.017365Z"}}
