s.fct_retailer_performance\", \"invocation_id\": \"efb092a1-a021-4a85-a7d3-e521aff8ddca\", \"name\": \"fct_retailer_performance\", \"schema\": \"marts\", \"status\": \"success\", \"execution_time\": 0.2, \"full_refresh\": false, \"materialization\": \"table\", \"compiled_code\": null, \"generated_at\": \"2026-10-06 09:43:17\"}, {\"unique_id\": \"model.commerce_analytics.dim_retailers\", \"invocation_id\": \"efb092a1-a021-4a85-a7d3-e521aff8ddca\", \"name\": \"dim_retailers\", \"schema\": \"marts\", \"status\": \"success\", \"execution_time\": 0.3, \"full_refresh\": false, \"materialization\": \"table\", \"compiled_code\": null, \"generated_at\": \"2026-10-06 09:43:17\"}, {\"unique_id\": \"model.commerce_analytics.dim_customers\", \"invocation_id\": \"efb092a1-a021-4a85-a7d3-e521aff8ddca\", \"name\": \"dim_customers\", \"schema\": \"marts\", \"status\": \"success\", \"execution_time\": 0.3, \"full_refresh\": false, \"materialization\": \"table\", \"compiled_code\": null, \"generated_at\": \"2026-10-06 09:43:17\"}, {\"unique_id\": \"model.commerce_analytics.dim_retailers\", \"invocation_id\": \"12258332-a5bf-4292-aa8f-8b5971b859f3\", \"name\": \"dim_retailers\", \"schema\": \"marts\", \"status\": \"success\", \"execution_time\": 0.2, \"full_refresh\": false, \"materialization\": \"table\", \"compiled_code\": \"-- SCD Type 2: tracks history via dbt snapshots\\n-- Each row represents one version of a retailer's profile\\n-- is_current = true for the active record\\nselect\\n    dbt_scd_id                                                  as retailer_key,\\n    retailer_id,\\n    name                                                        as retailer_name,\\n    zone,\\n    category,\\n    status,\\n    onboarded_at,\\n    dbt_valid_from                                              as valid_from,\\n    dbt_valid_to                                                as valid_to,\\n    case when dbt_valid_to is null then true else false end      as is_current\\nfrom \\\"commerce_ingestion\\\".\\\"snapshots\\\".\\\"snap_retailers\\\"\", \"generated_at\": \"2026-10-06 09:45:20\"}, {\"unique_id\": \"model.commerce_analytics.fct_payment_channel_summary\", \"invocation_id\": \"12258332-a5bf-4292-aa8f-8b5971b859f3\", \"name\": \"fct_payment_channel_summary\", \"schema\": \"marts\", \"status\": \"success\", \"execution_time\": 0.1, \"full_refresh\": false, \"materialization\": \"table\", \"compiled_code\": \"select\\n    cast(created_at as date)        as order_date,\\n    payment_method,\\n    order_channel,\\n    count(distinct order_id)        as order_count,\\n    sum(total_amount)               as total_revenue,\\n    avg(total_amount)               as avg_order_value,\\n    sum(discount_amount)            as total_discounts,\\n    avg(rating)                     as avg_rating,\\n    count(case when status = 'cancelled' then 1 end) as cancelled_count,\\n    round(\\n        count(case when status = 'cancelled' then 1 end) * 100.0\\n        / nullif(count(distinct order_id), 0),\\n        2\\n    )                               as cancellation_rate\\nfrom \\\"commerce_ingestion\\\".\\\"marts\\\".\\\"fct_orders\\\"\\ngroup by 1, 2, 3\", \"generated_at\": \"2026-10-06 09:45:20\"}, {\"unique_id\": \"model.commerce_analytics.dim_customers\", \"invocation_id\": \"12258332-a5bf-4292-aa8f-8b5971b859f3\", \"name\": \"dim_customers\", \"schema\": \"marts\", \"status\": \"success\", \"execution_time\": 0.2, \"full_refresh\": false, \"materialization\": \"table\", \"compiled_code\": \"-- SCD Type 1: latest state only, overwrites on change\\nselect\\n    customer_id,\\n    customer_name,\\n    phone,\\n    email,\\n    tier,\\n    created_at,\\n    updated_at\\nfrom \\\"commerce_ingestion\\\".\\\"staging\\\".\\\"stg_customers\\\"\", \"generated_at\": \"2026-10-06 09:45:20\"}, {\"unique_id\": \"model.commerce_analytics.stg_orders\", \"invocation_id\": \"12258332-a5bf-4292-aa8f-8b5971b859f3\", \"name\": \"stg_orders\", \"schema\": \"staging\", \"status\": \"success\", \"execution_time\": 0.2, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"with source as (\\n    select * from \\\"commerce_ingestion\\\".\\\"raw\\\".\\\"orders\\\"\\n)\\n\\nselect\\n    order_id,\\n    customer_id,\\n    retailer_id,\\n    zone,\\n    lower(status)               as status,\\n    lower(payment_method)       as payment_method,\\n    lower(order_channel)        as order_channel,\\n    subtotal,\\n    discount_amount,\\n    delivery_fee,\\n    total_amount,\\n    estimated_delivery_minutes,\\n    actual_delivery_minutes,\\n    rating,\\n    created_at,\\n    updated_at\\nfrom source\", \"generated_at\": \"2026-10-06 09:45:20\"}, {\"unique_id\": \"model.commerce_analytics.fct_daily_zone_summary\", \"invocation_id\": \"12258332-a5bf-4292-aa8f-8b5971b859f3\", \"name\": \"fct_daily_zone_summary\", \"schema\": \"marts\", \"status\": \"success\", \"execution_time\": 0.1, \"full_refresh\": false, \"materialization\": \"table\", \"compiled_code\": \"with orders as (\\n    select * from \\\"commerce_ingestion\\\".\\\"marts\\\".\\\"fct_orders\\\"\\n),\\n\\nzones as (\\n    select * from \\\"commerce_ingestion\\\".\\\"main\\\".\\\"zone_lookup\\\"\\n)\\n\\nselect\\n    cast(o.created_at as date)                                        as order_date,\\n    o.zone,\\n    z.region,\\n    z.area_type,\\n    count(distinct o.order_id)                                        as order_count,\\n    count(distinct o.customer_id)                                     as unique_customers,\\n    count(distinct o.retailer_id)                                     as unique_retailers,\\n    sum(o.total_amount)                                               as total_revenue,\\n    sum(o.subtotal)                                                   as gross_revenue,\\n    sum(o.discount_amount)                                            as total_discounts,\\n    sum(o.delivery_fee)                                               as total_delivery_fees,\\n    avg(o.total_amount)                                               as avg_order_value,\\n    avg(o.rating)                                                     as avg_rating,\\n    avg(o.actual_delivery_minutes)                                    as avg_delivery_minutes,\\n    count(case when o.delivery_performance = 'on_time' then 1 end)    as on_time_count,\\n    count(case when o.delivery_performance is not null then 1 end)    as delivered_count,\\n    round(\\n        count(case when o.delivery_performance = 'on_time' then 1 end) * 100.0\\n        / nullif(count(case when o.delivery_performance is not null then 1 end), 0),\\n        2\\n    )                                                                 as on_time_pct,\\n    count(case when o.status = 'cancelled' then 1 end)                as cancelled_count,\\n    round(\\n        count(case when o.status = 'cancelled' then 1 end) * 100.0\\n        / nullif(count(distinct o.order_id), 0),\\n        2\\n    )                                                                 as cancellation_rate\\nfrom orders o\\nleft join zones z on o.zone = z.zone\\ngroup by 1, 2, 3, 4\", \"generated_at\": \"2026-10-06 09:45:20\"}, {\"unique_id\": \"model.commerce_analytics.stg_retailers\", \"invocation_id\": \"12258332-a5bf-4292-aa8f-8b5971b859f3\", \"name\": \"stg_retailers\", \"schema\": \"staging\", \"status\": \"success\", \"execution_time\": 0.1, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"with source as (\\n    select * from \\\"commerce_ingestion\\\".\\\"raw\\\".\\\"retailers\\\"\\n)\\n\\nselect\\n    retailer_id,\\n    name            as retailer_name,\\n    zone,\\n    category,\\n    lower(status)   as status,\\n    onboarded_at,\\n    updated_at\\nfrom source\", \"generated_at\": \"2026-10-06 09:45:20\"}, {\"unique_id\": \"model.commerce_analytics.fct_retailer_performance\", \"invocation_id\": \"12258332-a5bf-4292-aa8f-8b5971b859f3\", \"name\": \"fct_retailer_performance\", \"schema\": \"marts\", \"status\": \"success\", \"execution_time\": 0.2, \"full_refresh\": false, \"materialization\": \"table\", \"compiled_code\": \"with orders as (\\n    select * from \\\"commerce_ingestion\\\".\\\"marts\\\".\\\"fct_orders\\\"\\n),\\n\\nitems as (\\n    select * from \\\"commerce_ingestion\\\".\\\"marts\\\".\\\"fct_order_items\\\"\\n    where order_status != 'cancelled'\\n),\\n\\nretailers as (\\n    select * from \\\"commerce_ingestion\\\".\\\"marts\\\".\\\"dim_retailers\\\"\\n    where is_current = true\\n),\\n\\nzones as (\\n    select * from \\\"commerce_ingestion\\\".\\\"main\\\".\\\"zone_lookup\\\"\\n)\\n\\nselect\\n    r.retailer_id,\\n    r.retailer_name,\\n    r.zone,\\n    z.region,\\n    z.area_type,\\n    r.category,\\n    r.status,\\n    count(distinct o.order_id)                                      as total_orders,\\n    count(distinct case when o.status != 'cancelled' then o.order_id end) as completed_orders,\\n    count(distinct o.customer_id)                                   as unique_customers,\\n    sum(o.total_amount)                                             as total_revenue,\\n    avg(o.total_amount)                                             as avg_order_value,\\n    sum(o.discount_amount)                                          as total_discounts_given,\\n    sum(i.quantity)                                                  as total_items_sold,\\n    avg(o.rating)                                                   as avg_rating,\\n    avg(o.actual_delivery_minutes)                                  as avg_delivery_minutes,\\n    count(case when o.delivery_performance = 'on_time' then 1 end)  as on_time_count,\\n    count(case when o.delivery_performance is not null then 1 end)  as delivered_count,\\n    round(\\n        count(case when o.delivery_performance = 'on_time' then 1 end) * 100.0\\n        / nullif(count(case when o.delivery_performance is not null then 1 end), 0),\\n        2\\n    )                                                               as on_time_pct,\\n    round(\\n        count(case when o.status = 'cancelled' then 1 end) * 100.0\\n        / nullif(count(distinct o.order_id), 0),\\n        2\\n    )                                                               as cancellation_rate,\\n    min(o.created_at)                                               as first_order_at,\\n    max(o.created_at)                                               as last_order_at\\nfrom retailers r\\nleft join orders o on r.retailer_id = o.retailer_id\\nleft join items i on o.order_id = i.order_id\\nleft join zones z on r.zone = z.zone\\ngroup by 1, 2, 3, 4, 5, 6, 7\", \"generated_at\": \"2026-10-06 09:45:20\"}, {\"unique_id\": \"model.commerce_analytics.stg_products\", \"invocation_id\": \"12258332-a5bf-4292-aa8f-8b5971b859f3\", \"name\": \"stg_products\", \"schema\": \"staging\", \"status\": \"success\", \"execution_time\": 0.1, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"with source as (\\n    select * from \\\"commerce_ingestion\\\".\\\"raw\\\".\\\"products\\\"\\n)\\n\\nselect\\n    product_id,\\n    name            as product_name,\\n    category,\\n    price,\\n    created_at,\\n    updated_at\\nfrom source\", \"generated_at\": \"2026-10-06 09:45:20\"}, {\"unique_id\": \"model.commerce_analytics.fct_orders\", \"invocation_id\": \"12258332-a5bf-4292-aa8f-8b5971b859f3\", \"name\": \"fct_orders\", \"schema\": \"marts\", \"status\": \"success\", \"execution_time\": 0.2, \"full_refresh\": false, \"materialization\": \"incremental\", \"compiled_code\": \"\\n\\nwith __dbt__cte__int_orders_enriched as (\\nwith orders as (\\n    select * from \\\"commerce_ingestion\\\".\\\"staging\\\".\\\"stg_orders\\\"\\n),\\n\\ncustomers as (\\n    select * from \\\"commerce_ingestion\\\".\\\"staging\\\".\\\"stg_customers\\\"\\n),\\n\\nretailers as (\\n    select * from \\\"commerce_ingestion\\\".\\\"staging\\\".\\\"stg_retailers\\\"\\n)\\n\\nselect\\n    o.order_id,\\n    o.customer_id,\\n    c.customer_name,\\n    c.tier              as customer_tier,\\n    o.retailer_id,\\n    r.retailer_name,\\n    r.category          as retailer_category,\\n    o.zone,\\n    o.status,\\n    o.payment_method,\\n    o.order_channel,\\n    o.subtotal,\\n    o.discount_amount,\\n    o.delivery_fee,\\n    o.total_amount,\\n    o.estimated_delivery_minutes,\\n    o.actual_delivery_minutes,\\n    o.actual_delivery_minutes - o.estimated_delivery_minutes as delivery_delay_minutes,\\n    case\\n        when o.actual_delivery_minutes is null then null\\n        when o.actual_delivery_minutes <= o.estimated_delivery_minutes then 'on_time'\\n        when o.actual_delivery_minutes <= o.estimated_delivery_minutes + 15 then 'slightly_late'\\n        when o.actual_delivery_minutes <= o.estimated_delivery_minutes + 30 then 'late'\\n        else 'very_late'\\n    end as delivery_performance,\\n    o.rating,\\n    o.created_at,\\n    o.updated_at\\nfrom orders o\\nleft join customers c on o.customer_id = c.customer_id\\nleft join retailers r on o.retailer_id = r.retailer_id\\n) select\\n    order_id,\\n    customer_id,\\n    customer_name,\\n    customer_tier,\\n    retailer_id,\\n    retailer_name,\\n    retailer_category,\\n    zone,\\n    status,\\n    payment_method,\\n    order_channel,\\n    subtotal,\\n    discount_amount,\\n    delivery_fee,\\n    total_amount,\\n    estimated_delivery_minutes,\\n    actual_delivery_minutes,\\n    delivery_delay_minutes,\\n    delivery_performance,\\n    rating,\\n    created_at,\\n    updated_at\\nfrom __dbt__cte__int_orders_enriched\\n\\n\\nwhere updated_at > (select max(updated_at) from \\\"commerce_ingestion\\\".\\\"marts\\\".\\\"fct_orders\\\")\\n\", \"generated_at\": \"2026-10-06 09:45:20\"}, {\"unique_id\": \"model.commerce_analytics.dim_products\", \"invocation_id\": \"12258332-a5bf-4292-aa8f-8b5971b859f3\", \"name\": \"dim_products\", \"schema\": \"marts\", \"status\": \"success\", \"execution_time\": 0.2, \"full_refresh\": false, \"materialization\": \"table\", \"compiled_code\": \"-- SCD Type 2: tracks price history via dbt snapshots\\n-- Each row represents one version of a product's profile\\n-- is_current = true for the active record\\nselect\\n    dbt_scd_id                                                  as product_key,\\n    product_id,\\n    name                                                        as product_name,\\n    category,\\n    price,\\n    dbt_valid_from                                              as valid_from,\\n    dbt_valid_to                                                as valid_to,\\n    case when dbt_valid_to is null then true else false end      as is_current\\nfrom \\\"commerce_ingestion\\\".\\\"snapshots\\\".\\\"snap_products\\\"\", \"generated_at\": \"2026-10-06 09:45:20\"}, {\"unique_id\": \"model.commerce_analytics.fct_order_items\", \"invocation_id\": \"12258332-a5bf-4292-aa8f-8b5971b859f3\", \"name\": \"fct_order_items\", \"schema\": \"marts\", \"status\": \"success\", \"execution_time\": 0.2, \"full_refresh\": false, \"materialization\": \"incremental\", \"compiled_code\": \"\\n\\nwith __dbt__cte__int_order_items_enriched as (\\nwith items as (\\n    select * from \\\"commerce_ingestion\\\".\\\"staging\\\".\\\"stg_order_items\\\"\\n),\\n\\nproducts as (\\n    select * from \\\"commerce_ingestion\\\".\\\"staging\\\".\\\"stg_products\\\"\\n),\\n\\norders as (\\n    select * from \\\"commerce_ingestion\\\".\\\"staging\\\".\\\"stg_orders\\\"\\n)\\n\\nselect\\n    i.item_id,\\n    i.order_id,\\n    o.customer_id,\\n    o.retailer_id,\\n    o.zone,\\n    o.status            as order_status,\\n    o.payment_method,\\n    o.order_channel,\\n    i.product_id,\\n    i.product_name,\\n    p.category          as product_category,\\n    i.quantity,\\n    i.unit_price,\\n    i.line_total,\\n    i.created_at\\nfrom items i\\nleft join products p on i.product_id = p.product_id\\nleft join orders o on i.order_id = o.order_id\\n) select\\n    item_id,\\n    order_id,\\n    customer_id,\\n    retailer_id,\\n    zone,\\n    order_status,\\n    payment_method,\\n    order_channel,\\n    product_id,\\n    product_name,\\n    product_category,\\n    quantity,\\n    unit_price,\\n    line_total,\\n    created_at\\nfrom __dbt__cte__int_order_items_enriched\\n\\n\\nwhere created_at > (select max(created_at) from \\\"commerce_ingestion\\\".\\\"marts\\\".\\\"fct_order_items\\\")\\n\", \"generated_at\": \"2026-10-06 09:45:20\"}, {\"unique_id\": \"model.commerce_analytics.stg_order_items\", \"invocation_id\": \"12258332-a5bf-4292-aa8f-8b5971b859f3\", \"name\": \"stg_order_items\", \"schema\": \"staging\", \"status\": \"success\", \"execution_time\": 0.2, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"with source as (\\n    select * from \\\"commerce_ingestion\\\".\\\"raw\\\".\\\"order_items\\\"\\n)\\n\\nselect\\n    item_id,\\n    order_id,\\n    product_id,\\n    product_name,\\n    quantity,\\n    unit_price,\\n    quantity * unit_price   as line_total,\\n    created_at\\nfrom source\", \"generated_at\": \"2026-10-06 09:45:20\"}, {\"unique_id\": \"model.commerce_analytics.stg_customers\", \"invocation_id\": \"12258332-a5bf-4292-aa8f-8b5971b859f3\", \"name\": \"stg_customers\", \"schema\": \"staging\", \"status\": \"success\", \"execution_time\": 0.3, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"with source as (\\n    select * from \\\"commerce_ingestion\\\".\\\"raw\\\".\\\"customers\\\"\\n)\\n\\nselect\\n    customer_id,\\n    name            as customer_name,\\n    phone,\\n    email,\\n    lower(tier)     as tier,\\n    created_at,\\n    updated_at\\nfrom source\", \"generated_at\": \"2026-10-06 09:45:20\"}]--ELEMENTARY-MACRO-OUTPUT-END--"}, "info": {"category": "", "code": "I062", "extra": {}, "invocation_id": "82473717-fa01-4782-b427-c1f21197092a", "level": "info", "msg": "Elementary: --ELEMENTARY-MACRO-OUTPUT-START--[{\"unique_id\": \"model.commerce_analyt