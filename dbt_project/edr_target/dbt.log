{"data": {"conn_name": "macro_log_macro_results", "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.12.5\", \"profile_name\": \"elementary\", \"target_name\": \"dev\", \"connection_name\": \"macro_log_macro_results\"} */\nselect\n      'commerce_ingestion' as database,\n      table_name as name,\n      table_schema as schema,\n      CASE table_type\n        WHEN 'BASE TABLE' THEN 'table'\n        WHEN 'VIEW' THEN 'view'\n        WHEN 'LOCAL TEMPORARY' THEN 'table'\n        END as type\n    from system.information_schema.tables\n    where lower(table_schema) = 'main'\n    and lower(table_catalog) = 'commerce_ingestion'\n  "}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "b944af88-b768-49a7-94f6-da1efdb2cdba", "level": "debug", "msg": "On macro_log_macro_results: /* {\"app\": \"dbt\", \"dbt_version\": \"1.12.5\", \"profile_name\": \"elementary\", \"target_name\": \"dev\", \"connection_name\": \"macro_log_macro_results\"} */\nselect\n      'commerce_ingestion' as database,\n      table_name as name,\n      table_schema as schema,\n      CASE table_type\n        WHEN 'BASE TABLE' THEN 'table'\n        WHEN 'VIEW' THEN 'view'\n        WHEN 'LOCAL TEMPORARY' THEN 'table'\n        END as type\n    from system.information_schema.tables\n    where lower(table_schema) = 'main'\n    and lower(table_catalog) = 'commerce_ingestion'\n  ", "name": "SQLQuery", "pid": 42282, "thread": "MainThread", "ts": "2026-10-08T13:06:24.914270Z"}}
